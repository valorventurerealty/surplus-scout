APP_NAME="VVR Command Center"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://valorventure.business
APP_TIMEZONE=America/New_York

# Surplus Scout — Osceola Clerk Phase 1
OSCEOLA_SURPLUS_REPORT_URL=https://courts.osceolaclerk.com/reports/TaxDeedsSurplusFundsAvailableWeb.pdf
# Optional protected relay used when shared hosting cannot reach the Clerk directly.
OSCEOLA_SURPLUS_DOWNLOAD_URL=
OSCEOLA_SURPLUS_RELAY_TOKEN=
OSCEOLA_SURPLUS_REQUEST_TIMEOUT=30
OSCEOLA_SURPLUS_REQUEST_RETRIES=2
OSCEOLA_SURPLUS_MAX_FILE_BYTES=15728640
OSCEOLA_SURPLUS_MINIMUM_RECORDS=1
# Optional fallback when smalot/pdfparser is not installed (absolute server path).
PDF_TO_TEXT_BINARY=
VVR_DRIVE_URL="https://drive.google.com/drive/folders/1k0sAuTeEZtN9TvyTaws2yebd064kV3mh?usp=drive_link"
VVR_MAILERS_URL="https://app-us1.stannp.com/"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

INITIAL_ADMIN_NAME="VVR Owner"
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vvr_command_center
DB_USERNAME=vvr_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Set this to persistent storage on worker machines.
# LOCAL_FILESYSTEM_ROOT=/data/surplus-scout/private
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@valorventure.business"
MAIL_FROM_NAME="Valor Venture Realty"
VVR_EMAIL_MAX_RECIPIENTS=10
VVR_EMAIL_HOURLY_USER_LIMIT=30
VVR_EMAIL_MAX_ATTACHMENTS=5
VVR_EMAIL_ATTACHMENT_MAX_KB=10240
VVR_EMAIL_DELETED_DRAFT_RETENTION_DAYS=30

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# VVR AI — keep this key private and never expose it through Vite or browser JavaScript.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_DEFAULT_MODEL=gemini-3.6-flash
GEMINI_EXTRACTION_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_REQUEST_TIMEOUT=90
GEMINI_MAX_RETRIES=2
AI_MAX_TOOL_ITERATIONS=8
AI_APPROVAL_EXPIRATION_MINUTES=60
AI_DAILY_USER_LIMIT=100
AI_FILE_UPLOAD_LIMIT_KB=10240
PRE_AUCTION_CSV_MAX_ROWS=500
PRE_AUCTION_CSV_EXPIRATION_HOURS=24
SURPLUS_CSV_MAX_ROWS=500
AI_MAX_TEXT_CHARACTERS=250000
PROPERTY_INTAKE_EXPIRATION_HOURS=24
CONTACT_INTAKE_EXPIRATION_HOURS=24
SURPLUS_INTAKE_EXPIRATION_HOURS=24
VVR_ARMORY_DELETED_SESSION_RETENTION_DAYS=30

# Beside → Zapier → VVR. Generate a private 64-character value and send it only in the X-VVR-Beside-Secret header.
BESIDE_WEBHOOK_SECRET=

# Google Calendar OAuth — secrets remain server-side and must never use a VITE_ prefix.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI="https://valorventure.business/settings/integrations/google-calendar/callback"
GOOGLE_CALENDAR_REQUEST_TIMEOUT=20
GOOGLE_CALENDAR_DEFAULT_DURATION_MINUTES=60
